{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "baseUrl": "../..",
    "paths": {
      "@canary/core": ["packages/core/src/index.ts"],
      "@canary/coverage": ["packages/coverage/src/index.ts"],
      "@canary/runner": ["packages/runner/src/index.ts"],
      "@canary/web": ["apps/web/src/index.ts"]
    },
    "types": ["node"],
    "skipLibCheck": true,
    "noUncheckedIndexedAccess": true
  },
  "include": ["src/**/*.ts"]
}
