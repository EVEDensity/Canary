{
    "name":  "@canary/web",
    "version":  "0.1.0",
    "private":  true,
    "type":  "module",
    "scripts":  {
                    "build":  "tsc -p tsconfig.json",
                    "typecheck":  "tsc -p tsconfig.json --pretty false",
                    "test":  "vitest run"
                },
    "main":  "./dist/index.js",
    "types":  "./dist/index.d.ts",
    "exports":  {
                    ".":  {
                              "types":  "./dist/index.d.ts",
                              "import":  "./dist/index.js",
                              "default":  "./dist/index.js"
                          }
                },
    "dependencies":  {
                         "@canary/core":  "workspace:*",
                         "@canary/runner":  "workspace:*"
                     }
}