{
  "name": "canary",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "description": "Local project checks, architecture maps, and evidence-backed verification workspace.",
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "check": "pnpm typecheck && pnpm test && pnpm lint && pnpm format:check",
    "test": "node scripts/run-logged.mjs tests -- pnpm -r --if-present test",
    "test:quick": "node scripts/run-logged.mjs quick -- node --test scripts/tests/local-logs.test.mjs",
    "logs:status": "node scripts/logs.mjs",
    "logs:prune": "node scripts/logs.mjs",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "eslint .",
    "format": "prettier --write README.md CHANGELOG.md CONTRIBUTING.md SECURITY.md docs .github .changeset .prettierrc.json eslint.config.mjs",
    "format:check": "prettier --check README.md CHANGELOG.md CONTRIBUTING.md SECURITY.md docs .github .changeset .prettierrc.json eslint.config.mjs",
    "changeset": "changeset",
    "dev": "pnpm --filter @canary/cli dev",
    "demo": "pnpm --filter @canary/cli canary run --config canary.config.ts",
    "demo:headless": "pnpm --filter @canary/cli canary run --headless --no-open --config canary.config.ts",
    "check:demo": "pnpm demo:headless",
    "install:global": "node scripts/install-global.mjs",
    "canary": "pnpm --filter @canary/cli canary",
    "verify:r0": "node scripts/run-logged.mjs verification/r0 -- node scripts/verify-r0.mjs",
    "verify:r3": "node scripts/run-logged.mjs verification/r3 -- node scripts/verify-r3.mjs",
    "verify:r4": "node scripts/run-logged.mjs verification/r4 -- node scripts/verify-r4.mjs",
    "verify:distribution": "node scripts/verify-distribution.mjs",
    "verify:r5": "node scripts/run-logged.mjs verification/r5 -- node scripts/verify-r5.mjs",
    "verify:r6": "node scripts/run-logged.mjs verification/r6 -- node scripts/verify-r6.mjs",
    "verify:entry": "node scripts/run-logged.mjs verification/entry -- node scripts/verify-entry.mjs",
    "verify:r8": "node scripts/verify-r8.mjs",
    "verify:map": "node scripts/run-logged.mjs verification/map -- node scripts/verify-map.mjs",
    "verify:architecture-ci": "node scripts/run-logged.mjs verification/architecture-ci -- node scripts/verify-architecture-ci.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.2",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.0.0",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "prettier": "^3.9.6",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.70.0",
    "vitest": "^4.1.11"
  }
}
